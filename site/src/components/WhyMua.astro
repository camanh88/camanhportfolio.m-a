<script>
  // Scroll-driven scenes: the page sets --p (0..1) on a tall track while its sticky stage stays on screen.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const tracks = [...document.querySelectorAll<HTMLElement>('[data-cheers], [data-open]')];
  const progress = (track: HTMLElement, hold = 0.85) => {
    const r = track.getBoundingClientRect();
    return Math.min(1, Math.max(0, -r.top / ((r.height - innerHeight) * hold)));
  };
  if (reduce) tracks.forEach((t) => t.style.setProperty('--p', '1'));
  else {
    const update = () => tracks.forEach((t) => t.style.setProperty('--p', progress(t, t.hasAttribute('data-open') ? 0.8 : 0.82).toFixed(4)));
    let raf = 0;
    addEventListener('scroll', () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(update); }, { passive: true });
    addEventListener('resize', update);
    update();
  }
</script>

<script>
  // Contact: a bottle on wheels drives from the left edge to the right edge along the hills as the page is scrolled; the words appear behind it (left to right)
  const ct = document.querySelector<HTMLElement>('[data-ct]');
  const car = document.querySelector<SVGSVGElement>('[data-ct-car]');
  const roadEl = document.querySelector<HTMLElement>('.ct-road');
  const hill = document.querySelector<SVGPathElement>('[data-ct-line]');
  if (ct && car && roadEl && hill) {
    const L = hill.getTotalLength();
    const lenAtX = (x: number) => { let lo = 0, hi = L; for (let i = 0; i < 22; i++) { const m = (lo + hi) / 2; if (hill.getPointAtLength(m).x < x) lo = m; else hi = m; } return hi; };
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const place = (q: number) => {
      const w = roadEl.clientWidth, h = roadEl.clientHeight, cw = car.getBoundingClientRect().width || 90;
      const vx = Math.min(1440, Math.max(0, q * 1440));
      const a = hill.getPointAtLength(lenAtX(Math.max(0, vx - 12))), b = hill.getPointAtLength(lenAtX(Math.min(1440, vx + 12))), pt = hill.getPointAtLength(lenAtX(vx));
      const sx = w / 1440, sy = h / 120;
      const ang = Math.max(-14, Math.min(14, (Math.atan2((b.y - a.y) * sy, (b.x - a.x) * sx) * 180) / Math.PI));
      const px = pt.x * sx - cw / 2, py = pt.y * sy - car.getBoundingClientRect().height + 4;
      car.style.transform = `translate(${px}px, ${py}px) rotate(${ang}deg)`;
      ct.style.setProperty('--q', String(Math.min(1.15, Math.max(0, (px + cw * 0.5) / w)).toFixed(4)));
    };
    const update = () => {
      const r = ct.getBoundingClientRect();
      const p = still ? 1 : Math.min(1, Math.max(0, -r.top / ((r.height - innerHeight) * 0.78)));
      place(-0.06 + p * 1.12);
      if (p >= 1) ct.style.setProperty('--q', '1.15');
    };
    let raf = 0;
    addEventListener('scroll', () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(update); }, { passive: true });
    addEventListener('resize', update);
    update();
  }
</script>
